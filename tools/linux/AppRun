#!/bin/bash
# AppRun of the PL:Z-A Recomp AppImage (tools/linux/make_appimage.sh). Starts the launcher; the game code is generated
# and compiled on this PC from the player's own dump with the Python and zig shipped inside (runtime/gamebuild.c).
#
#   ZARecomp.AppImage                 the launcher (Game Files: pick base game, update, DLC, prod.keys -> Recompile)
#   ZARecomp.AppImage --play          straight into the game (once it is set up)
#   ZARecomp.AppImage --install       add it to the desktop's application menu (copies the AppImage to ~/Applications)
#   ZARecomp.AppImage --uninstall     remove that menu entry (game files, saves and settings stay)
#   ZARecomp.AppImage --data-dir      print the data folder (game files, saves, settings, lasrecomp.log)
#
# Data folder: LARECOMP_DATA_ROOT if set; else a "ZARecomp-data" folder beside the AppImage, when there is one
# (portable: make that folder to keep everything on another drive); else ~/.local/share/zarecomp.
set -u
HERE="$(dirname "$(readlink -f "$0")")"
APP="$HERE/opt/zarecomp"
SELF="${APPIMAGE:-$0}"
NAME="PL:Z-A Recomp"

if [ -z "${LARECOMP_DATA_ROOT:-}" ] && [ -n "${APPIMAGE:-}" ] && [ -d "$(dirname "$APPIMAGE")/ZARecomp-data" ]; then
    export LARECOMP_DATA_ROOT="$(dirname "$APPIMAGE")/ZARecomp-data"
fi
if [ -n "${LARECOMP_DATA_ROOT:-}" ]; then DATA="$LARECOMP_DATA_ROOT"
elif [ -n "${XDG_DATA_HOME:-}" ] && [ "${XDG_DATA_HOME#/}" != "$XDG_DATA_HOME" ]; then DATA="$XDG_DATA_HOME/zarecomp"
else DATA="${HOME:-/tmp}/.local/share/zarecomp"; fi

case "${1:-}" in
--data-dir) echo "$DATA"; exit 0 ;;
--install)
    [ -n "${APPIMAGE:-}" ] || { echo "--install works from the AppImage file"; exit 1; }
    mkdir -p "$HOME/Applications" "$HOME/.local/share/applications" "$HOME/.local/share/icons/hicolor/256x256/apps"
    dest="$HOME/Applications/ZARecomp-x86_64.AppImage"
    [ "$(readlink -f "$APPIMAGE")" = "$(readlink -f "$dest" 2>/dev/null)" ] || cp -f "$APPIMAGE" "$dest"
    chmod +x "$dest"
    cp -f "$HERE/zarecomp.png" "$HOME/.local/share/icons/hicolor/256x256/apps/zarecomp.png"
    sed -e "s|^Exec=.*|Exec=\"$dest\" %U|" -e "s|^TryExec=.*||" "$HERE/zarecomp.desktop" > "$HOME/.local/share/applications/zarecomp.desktop"
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q "$HOME/.local/share/applications" || true
    echo "Installed: $dest (menu: $NAME). Data folder: $DATA"
    exit 0 ;;
--uninstall)
    rm -f "$HOME/.local/share/applications/zarecomp.desktop" "$HOME/.local/share/icons/hicolor/256x256/apps/zarecomp.png"
    echo "Menu entry removed. The AppImage in ~/Applications and the data folder ($DATA) were left alone."
    exit 0 ;;
esac

# Requirements, said plainly instead of a crash: x86-64 with AVX2 (the game code is built for x86-64-v3), Vulkan
msg() {
    echo "$NAME: $1" >&2
    [ -t 2 ] && return
    if command -v zenity >/dev/null 2>&1; then zenity --error --title="$NAME" --text="$1" 2>/dev/null
    elif command -v kdialog >/dev/null 2>&1; then kdialog --title "$NAME" --error "$1" 2>/dev/null
    fi
}
grep -qw avx2 /proc/cpuinfo || { msg "This needs a CPU with AVX2 (Intel Haswell / 2013 or newer, AMD Zen or newer)."; exit 1; }
if ! ldconfig -p 2>/dev/null | grep -q 'libvulkan\.so\.1' && ! ls /usr/lib*/libvulkan.so.1 /usr/lib/*/libvulkan.so.1 >/dev/null 2>&1; then
    msg "No Vulkan loader (libvulkan.so.1) found. Install your distribution's Vulkan package (vulkan-icd-loader / libvulkan1 / vulkan-loader) and a Vulkan 1.3 GPU driver."
    exit 1
fi

# The shipped plugins (Steam relay, Legends Lua) into the data folder's plugins/ - the runtime lists that folder; they
# stay off until switched on on the Mods page. Newer copies replace older ones; plugins the player added stay.
mkdir -p "$DATA/plugins" "$DATA/lua" "$DATA/mods" 2>/dev/null
for f in "$APP"/plugins/*; do
    [ -f "$f" ] || continue
    d="$DATA/plugins/$(basename "$f")"
    cmp -s "$f" "$d" 2>/dev/null || cp -f "$f" "$d" 2>/dev/null
done
if [ -d "$APP/lua-examples" ]; then
    mkdir -p "$DATA/lua-examples" && cp -rf "$APP/lua-examples/." "$DATA/lua-examples/" 2>/dev/null
fi

# Started from Steam (a non-Steam game shortcut): an X11 window, so Steam Input can give it the controllers
[ -n "${SteamGameId:-}" ] && [ -z "${SDL_VIDEO_DRIVER:-}" ] && export SDL_VIDEO_DRIVER=x11
# Keep the AppImage's own environment out of the system tools the game may start (file dialogs, the browser)
unset PYTHONHOME PYTHONPATH
exec "$APP/lasrecomp" "$@"
